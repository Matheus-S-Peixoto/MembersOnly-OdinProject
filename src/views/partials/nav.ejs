<nav>
  <!-- LOGGED IN -->
  <% if(locals.user) { %>
    <% if(!locals.user.ismember) { %>
      <% if(locals.title !== 'Join the Club') { %>
        <a href="/posts/join-club">Join the Club</a>
      <% } %>  
    <% } %>  
    <a href="/auth/logout">Logout</a>
    
    <% if(locals.title !== 'Home Page') { %>
      <a href="/posts/">Home</a>  
    <% } %>

    <% if(locals.title === 'Home Page') { %>
      <a href="/posts/new-message">New Message</a>  
    <% } %>
    
  <!-- UNAUTHENTICATED -->
  <% } else { %>
    
    <% if(locals.title !== 'Register') { %>
      <a href="/auth/register">Register</a>
    <% } %>  

    <% if(locals.title !== 'Login') { %>
      <a href="/auth/login">Login</a>
    <% } %>

    <% if(locals.title !== 'Home Page') { %>
      <a href="/posts/">Home</a>  
    <% } %>

  <% } %>
</nav>

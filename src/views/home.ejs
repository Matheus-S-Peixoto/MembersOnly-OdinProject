<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <div class="message-pane">
      <%- include('./partials/nav.ejs') %>

      <% if(!locals.messages) { %>
        <h2>No messages yet.</h2>
      <% } else { %>  
        <% messages.forEach(msg => { %>
          <% if (locals.user.ismember) { %>
            <h2><%= msg.username %></h2>
            <p class="timestamp"><%= msg.posted_at %></p>
          <% } %>
          <textarea class="message-text" style="resize: none" disabled><%= msg.content %></textarea>
          <% if (locals.user.isadimn) { %>
            <a class="delete-button" href="/posts/<%= msg.id %>"></a>
          <% } %>  
        <% }); %>
      <% } %>
    </div>
  </body>
</html>

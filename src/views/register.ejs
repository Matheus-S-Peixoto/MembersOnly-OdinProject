<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/nav.ejs') %>

    <div class="register-pane">
      <h1 class="register-title">Please Register</h1>

      <form class="register-form" action="/auth/register" method="post">
        <div class="form-group">
          <label for="prefname">Prefered Name</label>
          <input id="prefname" name="prefname" placeholder="Name..." type="text" />

          <% if (locals.errors?.prefname) { %>
            <% errors.prefname.forEach((error) => { %>
              <p class="error-message"><%= error %></p>
            <% }) %>
          <% } %>
        </div>

        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" name="username" id="username" placeholder="Username..." />

          <% if (locals.errors?.username) { %>
            <% errors.username.forEach((error) => { %>
              <p class="error-message"><%= error %></p>
            <% }) %>
          <% } %>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" />
          
          <% if (locals.errors?.password) { %>
            <% errors.password.forEach((error) => { %>
              <p class="error-message"><%= error %></p>
            <% }) %>
          <% } %>
        </div>
        
        <button type="submit">Submit</button>
      </form>
    </div>
  </body>
</html>

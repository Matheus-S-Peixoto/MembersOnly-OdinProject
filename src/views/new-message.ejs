<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/nav.ejs') %>

    <div class="register-pane">
      <h1 class="register-title">New Message</h1>

      <form class="register-form" action="/posts/new-message" method="post">
        <div class="form-group">
          <label for="content">Type your message:</label>
          <textarea name="content" id="content"><%= locals.formData?.content || '' %></textarea>
          
          <% if (locals.errors) { %>
            <% errors.forEach((error) => { %>
              <p class="error-message"><%= error.msg %></p>
            <% }) %>
          <% } %>
        
        </div>
        
        
        <button type="submit">Submit</button>
      </form>
    </div>
  </body>
</html>
